__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
*.egg-info/

# Rasters/datos descargados en tiempo de ejecución (GWA, Köppen, etc.) --
# se re-descargan bajo demanda, no se versionan (mismo criterio ya usado
# para gwa_costa_rica_10m.tif / gwa_cri_10m.tif).
*.tif
*.zip
datos_clima/koppen/

# Secretos locales (BCCR_BEARER_TOKEN, etc.) -- nunca se commitean, ver
# .env.example para la plantilla. La caché del tipo de cambio se regenera
# sola con cada llamada exitosa al BCCR, tampoco se versiona.
.env
.env.*
!.env.example
data/cache_tipo_cambio.json
